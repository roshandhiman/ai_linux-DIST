#!/usr/bin/env bash
set -euo pipefail

data="${XDG_DATA_HOME:-$HOME/.local/share}"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
install_root="$data/mineos-ide"
runtime="$install_root/current/bin/codium"
extras=()
if [[ "${MINEOS_IDE_DISABLE_GPU:-0}" == 1 ]]; then
    extras+=(--disable-gpu)
fi
exec "$runtime" --user-data-dir "$config/MineOS IDE" --extensions-dir "$install_root/user-extensions" "${extras[@]}" "$@"
