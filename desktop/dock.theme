[PlankTheme]
TopRoundness=${TopRoundness}
BottomRoundness=${BottomRoundness}
LineWidth=${LineWidth}
OuterStrokeColor=${OuterStrokeColor}
FillStartColor=${FillStartColor}
FillEndColor=${FillEndColor}
InnerStrokeColor=${InnerStrokeColor}
[PlankDockTheme]
HorizPadding=${HorizPadding}
TopPadding=${TopPadding}
BottomPadding=${BottomPadding}
ItemPadding=${ItemPadding}
IndicatorSize=${IndicatorSize}
IconShadowSize=${IconShadowSize}
UrgentBounceHeight=0.5
LaunchBounceHeight=${LaunchBounceHeight}
FadeOpacity=0
ClickTime=${ClickTime}
UrgentBounceTime=400
LaunchBounceTime=${LaunchBounceTime}
ActiveTime=${ActiveTime}
SlideTime=${SlideTime}
FadeTime=${FadeTime}
HideTime=${HideTime}
GlowSize=15
GlowTime=4000
GlowPulseTime=1200
UrgentHueShift=0
ItemMoveTime=${ItemMoveTime}
CascadeHide=true
BadgeColor=170;;170;;170;;255
