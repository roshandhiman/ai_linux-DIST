# Debian packages installed into the MineOS image, one per line.
# Keep this list architecture-neutral: scripts/build-iso.sh adds the
# kernel (linux-image-<arch>) for the machine it builds on.

# ---- Base system --------------------------------------------------------
systemd
systemd-sysv
udev
sudo
curl
wget
git
htop

# ---- Networking, Bluetooth and sound -------------------------------------
network-manager
gir1.2-nm-1.0
network-manager-gnome
wireless-tools
wpasupplicant
bluetooth
bluez
blueman
pipewire
pipewire-pulse
wireplumber
pavucontrol

# ---- Virtual machine guest tools ------------------------------------------
# Screen resizing, clipboard and smooth mouse when MineOS runs in a VM.
# Each one only starts on its own hypervisor and stays idle elsewhere.
spice-vdagent
open-vm-tools-desktop

# ---- Display, sign-in and desktop -----------------------------------------
xorg
xserver-xorg
lightdm
lightdm-gtk-greeter
xfce4
xfce4-terminal
thunar
thunar-archive-plugin
mousepad
file-roller
firefox-esr
picom
plank
x11-utils
tint2
rofi
arc-theme
papirus-icon-theme
fonts-inter
dconf-cli
packagekit
packagekit-tools
gvfs-backends
gvfs-fuse
plymouth
plymouth-themes

# ---- Python and media libraries used by the MineOS apps ---------------------
python3
python3-tk
python3-serial
# python3-venv: the Laya router gets its own Python environment in /opt/laya.
python3-venv
python3-gi
python3-requests
python3-cairo
python3-gi-cairo
gir1.2-gtk-3.0
gir1.2-wnck-3.0
gir1.2-gstreamer-1.0
gstreamer1.0-gtk3
gstreamer1.0-libav
gstreamer1.0-plugins-good
ffmpeg

# ---- Terminal assistant (ai) and its local model server -----------------
# bubblewrap: the kernel sandbox the assistant runs model-written code in.
# libgomp1 / libssl3t64: shared libraries the bundled llama-server links to.
# libnotify-bin: notify-send, for mine.notify().
bubblewrap
libgomp1
libssl3t64
libnotify-bin
