#!/usr/bin/env bash
EVENT="${1:-unknown}"
DEVICE="${2:-none}"
LOGFILE="/var/log/ai-hardware.log"

echo "$(date -Iseconds) [KERNEL_EVENT] ${EVENT} ${DEVICE}" >> "${LOGFILE}"

if [[ -n "${DISPLAY:-}" || -f "/tmp/.X11-unix/X0" ]]; then
    export DISPLAY=":0"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
    notify-send "⚡ Hardware Connected" "Device ${DEVICE} ready for AI control" -u normal -a "AI Core" || true
fi

